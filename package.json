{
  "name": "@explore/public",
  "private": true,
  "description": "A workspace for cataloguing and running Explore apps from one Git root. It is an Nx monorepo, and organized around living C4 docs and shared packages.",
  "scripts": {
    "graph": "nx graph",
    "affected": "nx affected -t lint,test,build",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "build": "nx run-many -t build --all"
  },
  "devDependencies": {
    "@nx/eslint": "^22.0.0",
    "@nx/js": "^22.0.0",
    "@nx/workspace": "^22.0.0",
    "nx": "^22.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.8.2"
  },
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
