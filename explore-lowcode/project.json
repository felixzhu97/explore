{
  "name": "explore-lowcode",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "explore-lowcode",
  "projectType": "application",
  "tags": ["type:app", "scope:explore", "lang:typescript"],
  "implicitDependencies": ["shared-types", "dev-ports"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test -f project.json && echo explore-lowcode nx project ok",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test -f project.json && echo explore-lowcode test stub ok",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test -f project.json && echo explore-lowcode build stub ok",
        "cwd": "{projectRoot}"
      }
    }
  }
}
