{
  "name": "contracts-ai",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/contracts-ai",
  "projectType": "library",
  "tags": ["type:contract", "scope:explore", "kind:published-language"],
  "implicitDependencies": ["shared-types"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./scripts/validate-openapi.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./scripts/validate-openapi.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./scripts/validate-openapi.mjs",
        "cwd": "{projectRoot}"
      }
    }
  }
}
