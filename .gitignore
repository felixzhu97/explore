.DS_Store
**/.git.local/
**/.env
**/.env.*
!**/.env*.md

# Default-deny at repo root (full project trees stay local)
/*
!.gitignore
!README.md
!docs/
!docs/**

# Published project roots
!explore-ai/
!explore-iam/
!explore-chat/
!explore-commerce/
!explore-lowcode/

# Ignore one-level entries under project roots, then re-allow docs
*/*
!*/docs/
*/**
!*/docs/
!*/docs/developer/
!*/docs/developer/c4-model/
!*/docs/developer/c4-model/**
!*/docs/Glossary.md
!*/docs/product-owner/
!*/docs/product-owner/**

# Re-allow workspace strategy docs after */**
!docs/
!docs/**

# Optional project root README under any published project root
!*/README.md

# After */** so Cursor skills remain trackable
!.cursor/
!.cursor/**
