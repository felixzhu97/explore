{
  "name": "explore-iam",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "explore-iam",
  "projectType": "application",
  "tags": ["type:app", "scope:explore", "lang:java"],
  "implicitDependencies": ["explore-bom", "dev-ports"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test -f project.json && echo explore-iam nx project ok",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test -f project.json && echo explore-iam test stub ok",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test -f project.json && echo explore-iam build stub ok",
        "cwd": "{projectRoot}"
      }
    }
  }
}
