@startuml Domain-Model
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 50
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam package {
  BorderColor #000000
  FontColor #000000
}

title Explore workspace — Domain model (all catalogued projects)
hide empty members
hide methods

legend right
  |= Stereotype |= Meaning |
  | <<AggregateRoot>> | 聚合根 |
  | <<Entity>> | 实体 |
  | <<ValueObject>> | 值对象 |
  | <<Enum>> | 枚举 |
  | <<DomainEvent>> | 领域事件 |
  | ..> (cross-project) | 跨项目引用 |
endlegend

note as N_SCOPE
  One package per project, one nested package per bounded context.
  Attributes only; typed ids (e.g. ChatSessionId) appear as attribute
  types. Base classes, repositories and methods live in each project's
  docs/developer/c4-model/C4-Code-Domain-Model.puml.
  Domain events: only types present in code are drawn. Server sides
  publish no domain events; AiInvocationEvent is a persisted audit row,
  IAM audit records are aggregate roots.
  Lowcode has no local source: drawn from its Glossary and C3 (unverified).
end note

' ══ Explore IAM ═══════════════════════════════════════════
package "Explore IAM" as iam {
  package "common" as iam_common {
    class "ResourceName" as iam_ResourceName <<ValueObject>> {
      +value: String (ARN)
    }
    class "Permission" as iam_Permission <<ValueObject>> {
      +value: String
    }
    class "Resource" as iam_Resource <<ValueObject>> {
      +value: String
    }
    class "Scope" as iam_Scope <<ValueObject>> {
      +value: String
    }
    class "PrincipalId" as iam_PrincipalId <<ValueObject>> {
      +value: String
    }
    class "ReasonCode" as iam_ReasonCode <<ValueObject>> {
      +value: String
    }
    enum "Effect" as iam_Effect <<Enum>> {
      ALLOW
      DENY
    }
  }
  package "identity" as iam_identity {
    class "User" as iam_User <<AggregateRoot>> {
      +username: String
      +email: String
      +enabled: boolean
    }
    class "RoleBinding" as iam_RoleBinding <<Entity>> {
      +userId: String
      +roleId: String
    }
    class "Group" as iam_Group <<AggregateRoot>> {
      +name: String
    }
    class "GroupMember" as iam_GroupMember <<Entity>> {
      +userId: String
    }
    class "Role" as iam_Role <<AggregateRoot>> {
      +name: String
      +resourceName: ResourceName
      +trustPolicy: ImpersonationPolicy
    }
    class "ImpersonationPolicy" as iam_ImpersonationPolicy <<ValueObject>> {
      +json: String
    }
    class "TotpCredential" as iam_TotpCredential <<AggregateRoot>> {
      +userId: String
      +enabled: boolean
    }
    class "WebAuthnCredential" as iam_WebAuthnCredential <<ValueObject>> {
      +credentialId: byte[]
      +userHandle: byte[]
    }
  }
  package "policy" as iam_policy {
    class "AllowPolicy" as iam_AllowPolicy <<AggregateRoot>> {
      +name: String
      +statements: List<PolicyStatement>
    }
    class "PolicyStatement" as iam_PolicyStatement <<ValueObject>> {
      +effect: Effect
      +actions: Set<Permission>
      +resources: Set<Resource>
    }
    class "PolicyBinding" as iam_PolicyBinding <<AggregateRoot>> {
      +policyId: String
      +principalArn: ResourceName
    }
    class "Permission (catalog)" as iam_PermissionEntry <<AggregateRoot>> {
      +code: String
      +oauthScope: Scope
      +module: String
      +action: Permission
      +resource: Resource
    }
    class "AccessTuple" as iam_AccessTuple <<ValueObject>> {
      +principalId: PrincipalId
      +action: Permission
      +resource: Resource
    }
    class "AccessDecision" as iam_AccessDecision <<ValueObject>> {
      +effect: Effect
      +reasonCode: ReasonCode
    }
  }
  package "sts" as iam_sts {
    class "ShortLivedCredential" as iam_ShortLivedCredential <<AggregateRoot>> {
      +roleArn: ResourceName
      +sessionName: String
      +expiresAt: Instant
    }
  }
  package "federation" as iam_federation {
    class "OAuthClient" as iam_OAuthClient <<AggregateRoot>> {
      +clientId: ClientId
      +redirectUris: Set<RedirectUri>
      +scopes: Set<String>
    }
    class "FederatedIdentity" as iam_FederatedIdentity <<AggregateRoot>> {
      +userId: String
      +provider: String
      +externalSubject: String
    }
    class "ClientId" as iam_ClientId <<ValueObject>> {
      +value: String
    }
    class "RedirectUri" as iam_RedirectUri <<ValueObject>> {
      +value: String
    }
  }
  package "audit" as iam_audit {
    class "AdminActivity" as iam_AdminActivity <<AggregateRoot>> {
      +actor: AuditActor
      +action: String
      +target: AuditTarget
      +outcome: AuditOutcome
    }
    class "DataAccessLog" as iam_DataAccessLog <<AggregateRoot>> {
      +principalId: PrincipalId
      +action: Permission
      +resource: Resource
      +effect: Effect
    }
    class "AuditActor" as iam_AuditActor <<ValueObject>> {
      +value: String
    }
    class "AuditTarget" as iam_AuditTarget <<ValueObject>> {
      +type: String
      +targetId: String
    }
    enum "AuditOutcome" as iam_AuditOutcome <<Enum>> {
      SUCCESS
      FAILURE
    }
  }
}

iam_User "1" *-- "0..*" iam_RoleBinding
iam_RoleBinding --> iam_Role
iam_Group "1" *-- "0..*" iam_GroupMember
iam_User "1" o-- "0..1" iam_TotpCredential
iam_User "1" o-- "0..*" iam_WebAuthnCredential
iam_Role --> iam_ImpersonationPolicy
iam_Role --> iam_ResourceName
iam_AllowPolicy "1" *-- "1..*" iam_PolicyStatement
iam_PolicyStatement --> iam_Effect
iam_PolicyBinding --> iam_AllowPolicy : policyId
iam_PermissionEntry --> iam_Scope
iam_AccessDecision --> iam_ReasonCode
iam_ShortLivedCredential --> iam_Role : roleArn
iam_OAuthClient --> iam_ClientId
iam_OAuthClient "1" *-- "1..*" iam_RedirectUri
iam_FederatedIdentity --> iam_User : userId
iam_AdminActivity --> iam_AuditActor
iam_AdminActivity --> iam_AuditTarget
iam_AdminActivity --> iam_AuditOutcome
iam_DataAccessLog ..> iam_AccessDecision : records

