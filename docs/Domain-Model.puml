' ══ Explore Portfolio (FinPulse) ══════════════════════════
package "Explore Portfolio (FinPulse)" as pf {
  package "kernel" as pf_kernel {
    class "Money" as pf_Money <<ValueObject>> {
      +amount: BigDecimal
      +currency: CurrencyCode
    }
    class "CurrencyCode" as pf_CurrencyCode <<ValueObject>> {
      +code: String
    }
    class "Symbol" as pf_Symbol <<ValueObject>> {
      +value: String
    }
    class "Quantity" as pf_Quantity <<ValueObject>> {
      +value: BigDecimal
    }
  }
  package "auth / customer / account" as pf_customer {
    class "Session" as pf_Session <<Entity>> {
      +customerId: CustomerId
      +expiresAt: Instant
    }
    class "UserCredential" as pf_UserCredential <<Entity>> {
      +customerId: CustomerId
      +email: String
    }
    class "Customer" as pf_Customer <<AggregateRoot>> {
      +name: String
      +email: String
      +kycStatus: KycStatus
    }
    enum "KycStatus" as pf_KycStatus <<Enum>> {
      PENDING
      VERIFIED
      REJECTED
    }
    class "Account" as pf_Account <<Entity>> {
      +customerId: CustomerId
      +accountType: AccountType
      +currency: CurrencyCode
      +status: AccountStatus
    }
    enum "AccountType" as pf_AccountType <<Enum>> {
      CASH
      MARGIN
      BROKERAGE
    }
    enum "AccountStatus" as pf_AccountStatus <<Enum>> {
      ACTIVE
      CLOSED
      SUSPENDED
    }
    class "UserPreference" as pf_UserPreference <<Entity>> {
      +theme: String
      +language: String
      +notificationsEnabled: boolean
    }
  }
  package "instrument / market" as pf_instrument {
    class "Instrument" as pf_Instrument <<AggregateRoot>> {
      +symbol: Symbol
      +name: String
      +assetClass: AssetClass
      +exchange: String
    }
    enum "AssetClass" as pf_AssetClass <<Enum>> {
      EQUITY
      BOND
      OPTION
      OTHER
    }
    class "Bond" as pf_Bond <<Entity>> {
      +faceValue: BigDecimal
      +couponRate: BigDecimal
      +ytm: BigDecimal
      +duration: BigDecimal
    }
    class "Option" as pf_Option <<Entity>> {
      +underlyingInstrumentId: InstrumentId
      +strike: BigDecimal
      +expiry: Instant
      +optionType: OptionType
      +impliedVolatility: BigDecimal
    }
    enum "OptionType" as pf_OptionType <<Enum>> {
      CALL
      PUT
    }
    class "MarketData" as pf_MarketData <<Entity>> {
      +timestamp: Instant
      +open/high/low/close: BigDecimal
      +volume: BigDecimal
    }
  }
  package "portfolio / watchlist" as pf_portfolio {
    class "Portfolio" as pf_Portfolio <<AggregateRoot>> {
      +accountId: AccountId
      +name: String
      +baseCurrency: CurrencyCode
    }
    class "Position" as pf_Position <<Entity>> {
      +instrumentId: InstrumentId
      +quantity: Quantity
      +costBasis: BigDecimal
      +asOfDate: LocalDate
    }
    class "Watchlist" as pf_Watchlist <<AggregateRoot>> {
      +customerId: CustomerId
      +name: String
    }
    class "WatchlistItem" as pf_WatchlistItem <<Entity>> {
      +instrumentId: InstrumentId
      +addedAt: Instant
    }
  }
  package "order / payment / settlement" as pf_order {
    class "Order" as pf_Order <<AggregateRoot>> {
      +accountId: AccountId
      +instrumentId: InstrumentId
      +side: OrderSide
      +quantity: Quantity
      +orderType: OrderType
      +status: OrderStatus
    }
    enum "OrderSide" as pf_OrderSide <<Enum>> {
      BUY
      SELL
    }
    enum "OrderType" as pf_OrderType <<Enum>> {
      MARKET
      LIMIT
    }
    enum "OrderStatus" as pf_OrderStatus <<Enum>> {
      PENDING
      FILLED
      CANCELLED
    }
    class "Trade" as pf_Trade <<Entity>> {
      +quantity: Quantity
      +price: BigDecimal
      +fee: BigDecimal
      +executedAt: Instant
    }
    class "Payment" as pf_Payment <<Entity>> {
      +counterparty: String
      +amount: Money
      +status: PaymentStatus
    }
    enum "PaymentStatus" as pf_PaymentStatus <<Enum>> {
      PENDING
      COMPLETED
      FAILED
    }
    class "CashTransaction" as pf_CashTransaction <<Entity>> {
      +type: CashTxnType
      +amount: Money
      +status: CashTxnStatus
    }
    enum "CashTxnType" as pf_CashTxnType <<Enum>> {
      DEPOSIT
      WITHDRAWAL
      FEE
    }
    class "Settlement" as pf_Settlement <<Entity>> {
      +status: SettlementStatus
      +settledAt: Instant
    }
    enum "SettlementStatus" as pf_SettlementStatus <<Enum>> {
      PENDING
      SETTLED
    }
  }
}

