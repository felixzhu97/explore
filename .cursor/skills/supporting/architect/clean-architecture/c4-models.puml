## C3 - 组件图

### 订单服务组件图

```plantuml
@startuml ComponentDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title 组件图 - 订单服务

Container(order_service, "订单服务", "Node.js")

Container_Boundary(order_domain, "Domain Layer") {
    Component(order_entity, "Order Entity", "Class", "订单实体")
    Component(order_item, "OrderItem", "Value Object", "订单项")
    Component(pricing_service, "Pricing Service", "Domain Service", "价格计算")
    Component(order_repository, "IOrderRepository", "Interface", "仓储接口")
}

Container_Boundary(order_application, "Application Layer") {
    Component(create_order_usecase, "CreateOrderUseCase", "Use Case", "创建订单")
    Component(cancel_order_usecase, "CancelOrderUseCase", "Use Case", "取消订单")
    Component(order_dto, "OrderDTO", "Class", "数据传输对象")
}

Container_Boundary(order_infra, "Infrastructure Layer") {
    Component(postgres_order_repo, "PostgresOrderRepository", "Repository", "仓储实现")
    Component(order_event_publisher, "OrderEventPublisher", "Publisher", "发布领域事件")
}

Rel(order_service, create_order_usecase, "使用")
Rel(order_service, cancel_order_usecase, "使用")
Rel(create_order_usecase, order_entity, "创建/保存")
Rel(create_order_usecase, pricing_service, "调用")
Rel(create_order_usecase, order_repository, "调用接口")
Rel(cancel_order_usecase, order_entity, "修改状态")
Rel(postgres_order_repo, order_repository, "实现")
Rel(order_event_publisher, order_entity, "发布事件")

SHOW_LEGEND()
@enduml
```

## C4 - 代码详细图

### 类图示例

```plantuml
@startuml ClassDiagram
skinparam classAttributeIconSize 0

class Order {
    -id: OrderId
    -customerId: CustomerId
    -items: OrderItem[]
    -status: OrderStatus
    -createdAt: Date
    +create(props): Order
    +addItem(item): void
    +confirm(): void
    +cancel(): void
    +get total(): Money
}

class OrderItem {
    -productId: ProductId
    -quantity: number
    -price: Money
    +get subtotal(): Money
}

class Money {
    -amount: number
    -currency: string
    +create(amount, currency): Money
    +add(other): Money
    +multiply(factor): Money
    +isGreaterThan(other): boolean
}

class OrderStatus {
    <<enum>>
    PENDING
    CONFIRMED
    SHIPPED
    DELIVERED
    CANCELLED
}

interface IOrderRepository {
    +findById(id): Promise<Order>
    +save(order): Promise<void>
    +delete(id): Promise<void>
}

Order "1" o-- "n" OrderItem
OrderItem --> Money
Order --> OrderStatus
Order ..> IOrderRepository

@enduml
```

### 序列图示例

```plantuml
@startuml SequenceDiagram
autonumber

actor Customer
participant "API Gateway" as gateway
participant "Order Service" as orderService
participant "Order Entity" as order
participant "Payment Service" as payment
participant "Order Repository" as repo

Customer -> gateway: POST /orders
gateway -> orderService: CreateOrderUseCase.execute()

activate orderService
orderService -> order: Order.create()
activate order
order -> order: validate items
order -> order: calculate total
deactivate order

orderService -> payment: processPayment()
activate payment
payment -> payment: call payment gateway
alt payment success
    payment --> orderService: paymentId
    orderService -> order: confirm()
    orderService -> repo: save()
    activate repo
    repo --> orderService: saved
    deactivate repo
    orderService --> gateway: 201 Created
    gateway --> Customer: OrderResponse
else payment failed
    payment --> orderService: PaymentFailedError
    orderService --> gateway: 400 Bad Request
    gateway --> Customer: ErrorResponse
end
deactivate payment
deactivate orderService

@enduml
```

## 部署图

```plantuml
@startuml DeploymentDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title 部署图 - AWS 部署

Deployment_Node(aws, "AWS Cloud", "Amazon Web Services") {
    Deployment_Node(ecs, "ECS Cluster", "Docker Containers") {
        Container(web_server, "Web Server", "Nginx", "静态文件和反向代理")
        Container(api_cluster, "API Cluster", "Node.js", "API 服务")
    }
    
    Deployment_Node(rds, "RDS", "PostgreSQL") {
        ContainerDb(postgres, "Primary DB", "PostgreSQL 14", "主数据库")
        ContainerDb(read_replica, "Read Replica", "PostgreSQL 14", "只读副本")
    }
    
    Deployment_Node(cache, "ElastiCache", "Redis") {
        Container(redis_cluster, "Redis Cluster", "Redis 7", "缓存层")
    }
    
    Deployment_Node(s3, "S3", "Object Storage") {
        Container(storage, "Media Storage", "S3", "文件存储")
    }
}

Rel(web_server, api_cluster, "HTTPS 请求")
Rel(api_cluster, postgres, "主数据库连接")
Rel(api_cluster, read_replica, "只读查询")
Rel(api_cluster, redis_cluster, "缓存读写")
Rel(api_cluster, storage, "文件上传/下载")

SHOW_LEGEND()
@enduml
```

## 动态图

```plantuml
@startuml DynamicDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title 动态图 - 创建订单流程

Participant(customer, "Customer", "用户")
Participant(controller, "OrderController", "控制器")
Participant(usecase, "CreateOrderUseCase", "用例")
Participant(order, "Order Entity", "实体")
Participant(repository, "OrderRepository", "仓储")
Participant(publisher, "EventPublisher", "事件发布")

customer -> controller: POST /orders { items }
controller -> usecase: execute(input)
usecase -> order: create()
order -> order: validate()
order -> order: calculateTotal()
usecase -> repository: save(order)
repository -> repository: INSERT to DB
usecase -> publisher: publish(OrderCreated)
publisher -> publisher: dispatch to queue
usecase --> controller: OrderDTO
controller --> customer: 201 Created

@enduml
```

