## C2 - 容器图

### 后端服务容器图

```plantuml
@startuml ContainerDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title 容器图 - 电商平台后端

Person(customer, "客户", "网购用户")
Person(admin, "管理员", "后台管理人员")

System_Boundary(ecommerce, "电商平台") {
    Container(web_app, "Web 应用", "React", "提供用户界面")
    Container(api_gateway, "API 网关", "Kong/Nginx", "路由和认证")
    Container(user_service, "用户服务", "Node.js", "用户管理")
    Container(product_service, "商品服务", "Node.js", "商品 CRUD")
    Container(order_service, "订单服务", "Node.js", "订单处理")
    Container(payment_service, "支付服务", "Node.js", "支付集成")
    ContainerDb(database, "主数据库", "PostgreSQL", "存储核心数据")
    ContainerDb(redis, "缓存", "Redis", "会话和缓存")
    ContainerQueue(queue, "消息队列", "RabbitMQ", "异步消息处理")
}

System_Ext(payment_gateway, "支付网关", "Stripe API")
System_Ext(email_service, "邮件服务", "SendGrid API")

Rel(customer, web_app, "访问", "HTTPS")
Rel(admin, web_app, "管理", "HTTPS")
Rel(web_app, api_gateway, "API 调用")
Rel(api_gateway, user_service, "REST")
Rel(api_gateway, product_service, "REST")
Rel(api_gateway, order_service, "REST")
Rel(api_gateway, payment_service, "REST")
Rel(user_service, database, "读写")
Rel(product_service, database, "读写")
Rel(order_service, database, "读写")
Rel(order_service, queue, "发布事件")
Rel(payment_service, queue, "消费事件")
Rel(payment_service, payment_gateway, "调用")
Rel(payment_service, email_service, "发送通知")
Rel(user_service, redis, "缓存会话")
Rel(product_service, redis, "缓存商品")

SHOW_LEGEND()
@enduml
```

