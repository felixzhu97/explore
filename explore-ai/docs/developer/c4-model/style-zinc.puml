' Shared zinc look for Code domain model + Dynamic sequence diagrams.
' Do NOT use with structural C4 New Style diagrams (C1–C3 / Deployment).
' Tokens: developer/references/c4-model.md (do not invent a second palette).
' Plan delta (GitHub Primer diff fg, light): add #1A7F37 · remove #CF222E
' Render: white body + colored border; header text matches border color.

!theme plain

<style>
  document {
    BackgroundColor #FAFAFA
    FontColor #18181B
  }
  title {
    FontColor #09090B
    FontSize 18
    FontStyle bold
    Margin 20
  }
  legend {
    BackgroundColor #FFFFFF
    BorderColor #E4E4E7
    FontColor #3F3F46
    FontSize 11
    RoundCorner 12
    Padding 10
  }
  note {
    BackgroundColor #F8FAFC
    BorderColor #CBD5E1
    FontColor #334155
    FontSize 11
    RoundCorner 10
    Padding 10
    Shadowing 0
  }
  classDiagram {
    LineColor #A1A1AA
    LineThickness 1.2
    FontColor #52525B
    FontSize 11
    Padding 8
    Margin 10
    RoundCorner 12
    Shadowing 0

    class {
      BackgroundColor #FFFFFF
      HeaderBackgroundColor #FFFFFF
      HeaderFontColor #18181B
      BorderColor #D4D4D8
      FontColor #18181B
      FontSize 12
      RoundCorner 12
      Padding 8
      Shadowing 0
